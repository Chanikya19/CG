# ==============================================================================
# CipherGuard Backend Environment Configuration Template
# ==============================================================================

# Application Security Keys
SECRET_KEY=
JWT_SECRET=

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Unified DATABASE_URL (MySQL or SQLite)
# MySQL Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# SQLite Format: sqlite:///cipherguard.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cipherguard?charset=utf8mb4

# Option 2: Discrete MySQL Connection Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cipherguard
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Flask Environment Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SHARE_BASE_URL=http://localhost:5173

# Admin Initial Bootstrap Settings
ADMIN_EMAIL=admin@cipherguard.com
ADMIN_PASSWORD=CHANGE_ME

