# ==============================================================================
# CipherGuard Backend Environment Configuration Template
# ==============================================================================

# Application Security Keys
SECRET_KEY=
JWT_SECRET=

# Database Configuration URI (e.g., mysql+pymysql://<user>:<password>@<host>:<port>/<db_name> or sqlite:///cipherguard.db)
DATABASE_URL=

# Optional Discrete Database Variables
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Flask Environment Settings
FLASK_APP=
FLASK_ENV=
FLASK_DEBUG=
